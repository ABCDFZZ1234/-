-- 1. Position System Page
-- ==========================================
local PosPage = Pages["Position"]

local function CreatePosButton(name, defaultText, bgColor)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Font = Enum.Font.SourceSansBold
	btn.Text = defaultText
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 14
	btn.BackgroundColor3 = bgColor or Color3.fromRGB(45, 45, 45)
	btn.BorderSizePixel = 0
	btn.Size = UDim2.new(0.95, 0, 0, 30)
	btn.Parent = PosPage
	return btn
end

local SlotContainer = Instance.new("Frame")
SlotContainer.Name = "SlotContainer"
SlotContainer.BackgroundTransparency = 1
SlotContainer.Size = UDim2.new(0.95, 0, 0, 35)
SlotContainer.Parent = PosPage

local SlotButtons = {}
for i = 1, 3 do
	local slotBtn = Instance.new("TextButton")
	slotBtn.Name = "Slot" .. i
	slotBtn.Font = Enum.Font.SourceSans
	slotBtn.Text = "Slot " .. i .. "\n(Empty)"
	slotBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	slotBtn.TextSize = 12
	slotBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
	slotBtn.BorderSizePixel = 0
	slotBtn.Size = UDim2.new(0.31, 0, 1, 0)
	slotBtn.Position = UDim2.new((i - 1) * 0.34, 0, 0, 0)
	slotBtn.Parent = SlotContainer
	SlotButtons[i] = slotBtn
end

local SaveBtn = CreatePosButton("SavePosBtn", "Save to Slot 1 [" .. SaveKey.Name .. "]")
local ClearSlotBtn = CreatePosButton("ClearSlotBtn", "Clear Slot 1", Color3.fromRGB(180, 50, 50))
local ClearAllBtn = CreatePosButton("ClearAllBtn", "Clear All Slots", Color3.fromRGB(150, 0, 0))
local InstantTpBtn = CreatePosButton("InstantTpBtn", "Teleport to Slot 1 [" .. TeleportKey.Name .. "]")

local function UpdateUI()
	for i = 1, 3 do
		local status = SavedSlots[i] and "(Saved)" or "(Empty)"
		SlotButtons[i].Text = "Slot " .. i .. "\n" .. status
		SlotButtons[i].BackgroundColor3 = (i == SelectedSlot) and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
	end

	SaveBtn.Text = "Save to Slot " .. SelectedSlot .. " [" .. SaveKey.Name .. "]"
	ClearSlotBtn.Text = "Clear Slot " .. SelectedSlot
	InstantTpBtn.Text = "Teleport to Slot " .. SelectedSlot .. " [" .. TeleportKey.Name .. "]"
end

for i = 1, 3 do
	SlotButtons[i].MouseButton1Click:Connect(function()
		SelectedSlot = i
		UpdateUI()
	end)
end

SaveBtn.MouseButton1Click:Connect(function()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		SavedSlots[SelectedSlot] = char.HumanoidRootPart.CFrame
		UpdateUI()
	end
end)

ClearSlotBtn.MouseButton1Click:Connect(function()
	SavedSlots[SelectedSlot] = nil
	UpdateUI()
end)

ClearAllBtn.MouseButton1Click:Connect(function()
	for i = 1, 3 do SavedSlots[i] = nil end
	UpdateUI()
end)

InstantTpBtn.MouseButton1Click:Connect(function()
	local targetCFrame = SavedSlots[SelectedSlot]
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") and targetCFrame then
		char.HumanoidRootPart.CFrame = targetCFrame
	end
end)

-- Keybind Listeners
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.One then SelectedSlot = 1; UpdateUI()
	elseif input.KeyCode == Enum.KeyCode.Two then SelectedSlot = 2; UpdateUI()
	elseif input.KeyCode == Enum.KeyCode.Three then SelectedSlot = 3; UpdateUI()
	elseif input.KeyCode == SaveKey then SaveBtn:Activate()
	elseif input.KeyCode == TeleportKey then InstantTpBtn:Activate()
	end
end)

